---
import "@fontsource-variable/space-grotesk";
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";
import "@/styles/global.css";
import Seo from "@/components/Seo.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { siteData } from "@/data/site";

interface Props {
	title: string;
	description: string;
	/** Add " | Pinoy Techie" to the title (default true) */
	suffix?: boolean;
	image?: string;
	imageAlt?: string;
	type?: "website" | "article";
	publishedTime?: string;
	modifiedTime?: string;
	tags?: string[];
	noindex?: boolean;
	/** href of the nav button to highlight (defaults to the one matching the URL) */
	activeNav?: string;
	schema?: Record<string, unknown>[];
}

const { title, suffix = true, activeNav, ...rest } = Astro.props;
const fullTitle = suffix && !title.includes(siteData.name) ? `${title} | ${siteData.name}` : title;
---

<html lang={siteData.locale}>
	<Seo title={fullTitle} {...rest} />
	<body class="flex min-h-screen flex-col">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 nb-btn nb-btn-sm">
			Skip to content
		</a>
		<Header activeNav={activeNav} />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
