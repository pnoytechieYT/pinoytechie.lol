---
import { siteData } from "@/data/site";

const { social, footer } = siteData;
const year = new Date().getFullYear();
const groups = [
	{ title: "Explore", links: footer.explore },
	{ title: "Discover", links: footer.discover },
	{ title: "Legal", links: footer.legal },
];
---

<footer class="footer border-t-[3px] border-ink bg-ink text-stone-200">
	<div class="stripe !border-x-0"></div>
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:py-14 md:grid-cols-12 md:px-6">
		<div class="md:col-span-4">
			<a href="/" class="flex items-center gap-3">
				<img src={siteData.logo.small} alt="" width="52" height="52" class="h-13 w-13 rounded-full border-[3px] border-sun" loading="lazy" />
				<span class="text-2xl font-bold uppercase leading-none tracking-tight text-white">
					Pinoy<span class="ml-1 bg-sun px-1.5 py-0.5 text-ink">Techie</span>
				</span>
			</a>
			<p class="mt-5 max-w-sm leading-relaxed text-stone-300">{siteData.tagline}</p>
			<div class="mt-6 flex flex-wrap gap-3 text-sm">
				{
					social.youtube && (
						<a
							href={social.youtube}
							target="_blank"
							rel="noopener noreferrer"
							class="rounded-md border-2 border-stone-200 px-3.5 py-2 font-bold text-white shadow-[3px_3px_0_0_var(--color-sun)] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-sun hover:text-ink">
							YouTube ↗
						</a>
					)
				}
				{
					social.email && (
						<a
							href={`mailto:${social.email}`}
							class="rounded-md border-2 border-stone-200 px-3.5 py-2 font-bold text-white shadow-[3px_3px_0_0_var(--color-sun)] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5 hover:bg-sun hover:text-ink">
							Email
						</a>
					)
				}
			</div>
		</div>

		<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-8">
			{
				groups.map((group) => (
					<nav aria-label={group.title}>
						<h2 class="font-mono text-sm font-bold uppercase tracking-widest text-sun">{group.title}</h2>
						<ul class="mt-4 space-y-2.5">
							{group.links.map((link) => (
								<li>
									<a href={link.href} class="font-medium text-stone-200 underline-offset-4 hover:text-sun hover:underline">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>
	</div>

	<div class="border-t-2 border-dashed border-stone-600">
		<div class="mx-auto max-w-6xl space-y-3 px-4 py-6 text-xs leading-relaxed text-stone-300 md:px-6">
			<p>
				<strong class="font-mono uppercase tracking-wider text-sun">Disclaimer:</strong>
				{siteData.name} is an independent website. The banks, e-wallets and internet providers covered here (such as MariBank, GCash, Maya, Globe, Smart and DITO) and their names and logos are trademarks of their owners. This site is not
				affiliated with or endorsed by any of them or their parent companies. Rates, rewards, plans and terms can change, so confirm them in the official app or website.
				Nothing here is financial advice. See our <a href="/disclosure/" class="underline hover:text-sun">referral disclosure</a>.
			</p>
			<p class="font-mono">© {year} {siteData.name}. All rights reserved.</p>
		</div>
	</div>
</footer>

<style>
	.footer :global(:focus-visible) {
		outline-color: var(--color-sun);
	}
</style>
