---
interface Props {
	code: string;
	/** Button colour: red (default), dark or sun */
	variant?: "red" | "dark" | "sun" | "seal";
	class?: string;
}
const { code, variant = "red", class: className } = Astro.props;
const variants = { red: "nb-btn-red", dark: "nb-btn-dark", sun: "", seal: "angpao-seal" } as const;
---

<button
	type="button"
	data-copy={code}
	aria-label={`Copy referral code ${code}`}
	class:list={["nb-btn", variants[variant], className]}>
	<svg data-icon="copy" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"><rect width="14" height="14" x="8" y="8"></rect><path d="M4 16V2h14"></path></svg>
	<svg data-icon="done" aria-hidden="true" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="square" stroke-linejoin="miter"><path d="M20 6 9 17l-5-5"></path></svg>
	<span data-label aria-live="polite">Copy code</span>
</button>

<script>
	function setCopied(btn: HTMLButtonElement, copied: boolean) {
		btn.querySelector("[data-icon=copy]")?.classList.toggle("hidden", copied);
		btn.querySelector("[data-icon=done]")?.classList.toggle("hidden", !copied);
		const label = btn.querySelector<HTMLElement>("[data-label]");
		if (label) label.textContent = copied ? "Copied" : "Copy code";
	}

	async function copyText(text: string) {
		try {
			await navigator.clipboard.writeText(text);
		} catch {
			const area = document.createElement("textarea");
			area.value = text;
			area.style.position = "fixed";
			area.style.opacity = "0";
			document.body.appendChild(area);
			area.select();
			document.execCommand("copy");
			area.remove();
		}
	}

	document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
		btn.addEventListener("click", async () => {
			await copyText(btn.dataset.copy ?? "");
			setCopied(btn, true);
			setTimeout(() => setCopied(btn, false), 4000);
		});
	});
</script>
