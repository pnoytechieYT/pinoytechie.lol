---
import { pageUrl, pageWindow } from "@/lib/pagination";

interface Props {
	page: number;
	totalPages: number;
	/** Base path with trailing slash, e.g. "/blog/" or "/blog/category/maribank/" */
	basePath: string;
	/** "Showing 1-9 of 20 guides" line */
	from?: number;
	to?: number;
	total?: number;
	noun?: string;
}
const { page, totalPages, basePath, from, to, total, noun = "guides" } = Astro.props;
---

{
	totalPages > 1 && (
		<nav aria-label="Pagination" class="mt-14 flex flex-col items-center gap-4">
			<ul class="flex flex-wrap items-center justify-center gap-2.5">
				<li>
					{page > 1 ? (
						<a href={pageUrl(basePath, page - 1)} rel="prev" class="nb-page" aria-label="Previous page">← <span class="ml-1 hidden sm:inline">Prev</span></a>
					) : (
						<span class="nb-page" aria-disabled="true">← <span class="ml-1 hidden sm:inline">Prev</span></span>
					)}
				</li>
				{pageWindow(page, totalPages).map((n) => (
					<li>
						{n === "…" ? (
							<span class="nb-page-gap" aria-hidden="true">…</span>
						) : (
							<a
								href={pageUrl(basePath, n)}
								class="nb-page"
								aria-current={n === page ? "page" : undefined}
								aria-label={`Page ${n}`}>
								{n}
							</a>
						)}
					</li>
				))}
				<li>
					{page < totalPages ? (
						<a href={pageUrl(basePath, page + 1)} rel="next" class="nb-page" aria-label="Next page"><span class="mr-1 hidden sm:inline">Next</span> →</a>
					) : (
						<span class="nb-page" aria-disabled="true"><span class="mr-1 hidden sm:inline">Next</span> →</span>
					)}
				</li>
			</ul>
			{total !== undefined && (
				<p class="font-mono text-xs font-bold uppercase tracking-wide text-muted">
					Showing {from}–{to} of {total} {noun}
				</p>
			)}
		</nav>
	)
}
