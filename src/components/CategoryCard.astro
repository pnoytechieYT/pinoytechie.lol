---
import type { CategoryInfo } from "@/lib/posts";

interface Props {
	category: CategoryInfo;
}
const { category } = Astro.props;
---

<article class:list={["group nb-card nb-card-lift relative flex h-full flex-col p-6 hover:bg-sun-soft", category.pinned && "bg-sun-soft"]}>
	<div class="flex items-start justify-between gap-4">
		{
			category.logo ? (
				<img src={category.logo} alt="" width="72" height="72" class="h-[4.5rem] w-[4.5rem] rounded-2xl border-[3px] border-ink bg-white shadow-hard-sm" loading="lazy" />
			) : (
				<span class="flex h-[4.5rem] w-[4.5rem] items-center justify-center rounded-2xl border-[3px] border-ink bg-ink font-mono text-3xl font-bold text-sun shadow-hard-sm" aria-hidden="true">
					{category.badge ?? category.name.charAt(0)}
				</span>
			)
		}
		{category.pinned && <span class="nb-tag nb-tag-red">★ Pinned</span>}
	</div>
	<h3 class="mt-5 text-2xl font-bold leading-tight tracking-tight text-ink">
		<a href={category.path} class="after:absolute after:inset-0">{category.name}</a>
	</h3>
	<p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-body">{category.description}</p>
	<p class="mt-5 flex items-center border-t-2 border-dashed border-ink pt-4 font-mono text-xs font-bold uppercase text-ink">
		<span>{category.count} {category.count === 1 ? "guide" : "guides"}</span>
		<span aria-hidden="true" class="ml-auto text-lg leading-none transition-transform group-hover:translate-x-1">→</span>
	</p>
</article>
