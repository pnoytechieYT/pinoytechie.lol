---
import type { Crumb } from "@/lib/seo";

interface Props {
	items: Crumb[];
	dark?: boolean;
}
const { items, dark = false } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={["text-sm", dark ? "text-slate-300" : "text-slate-500"]}>
	<ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
		{
			items.map((item, i) => (
				<li class="flex items-center gap-2">
					{i > 0 && <span aria-hidden="true">/</span>}
					{i < items.length - 1 ? (
						<a href={item.href} class="hover:underline">{item.name}</a>
					) : (
						<span aria-current="page" class:list={["inline-block max-w-[14rem] truncate align-bottom sm:max-w-md", dark ? "text-white" : "text-slate-700"]}>{item.name}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
