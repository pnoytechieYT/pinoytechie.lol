---
import { formatDate, type Post } from "@/lib/posts";

interface Props {
	post: Post;
}
const { post } = Astro.props;
---

<a
	href={`/blog/${post.slug}/`}
	class="group grid gap-2 border-t border-line py-7 md:grid-cols-12 md:gap-6">
	<p class="text-sm font-medium text-slate md:col-span-3 md:pt-2">
		{formatDate(post.pubDate)}
	</p>
	<div class="md:col-span-9">
		<h3
			class="font-display text-2xl font-bold leading-tight decoration-sun decoration-4 underline-offset-4 group-hover:underline md:text-3xl">
			{post.meta.title}
		</h3>
		<p class="mt-2 max-w-2xl font-text text-slate">{post.meta.description}</p>
		<p class="mt-3 text-sm font-medium text-slate">{post.minutes} min read</p>
	</div>
</a>
