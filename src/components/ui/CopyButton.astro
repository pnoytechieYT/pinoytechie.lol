---
interface Props {
	code: string;
	class?: string;
}
const { code, class: className } = Astro.props;
---

<button
	type="button"
	data-copy={code}
	aria-label={`Copy referral code ${code}`}
	class:list={[
		"inline-flex items-center gap-2 rounded-full border-2 border-ink bg-ink px-5 py-3 font-display font-bold text-white transition-transform active:scale-95 hover:bg-white hover:text-ink",
		className,
	]}>
	<svg data-icon="copy" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
	<svg data-icon="done" aria-hidden="true" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
	<span data-label aria-live="polite">Copy code</span>
</button>

<script>
	function setCopied(btn: HTMLButtonElement, copied: boolean) {
		btn.querySelector("[data-icon=copy]")?.classList.toggle("hidden", copied);
		btn.querySelector("[data-icon=done]")?.classList.toggle("hidden", !copied);
		const label = btn.querySelector<HTMLElement>("[data-label]");
		if (label) label.textContent = copied ? "Copied" : "Copy code";
	}

	async function copyText(text: string) {
		try {
			await navigator.clipboard.writeText(text);
		} catch {
			const area = document.createElement("textarea");
			area.value = text;
			area.style.position = "fixed";
			area.style.opacity = "0";
			document.body.appendChild(area);
			area.select();
			document.execCommand("copy");
			area.remove();
		}
	}

	document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
		btn.addEventListener("click", async () => {
			await copyText(btn.dataset.copy ?? "");
			setCopied(btn, true);
			setTimeout(() => setCopied(btn, false), 4000);
		});
	});
</script>
