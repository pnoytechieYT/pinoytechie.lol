---
import { Image } from "astro:assets";

export interface Props {
	href: string;
	src: string;
	alt: string;
	label: string;
}

const { href, src, alt, label } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={label}
	class="inline-flex transition-transform duration-200 hover:-translate-y-1">
	<Image
		src={src}
		alt={alt}
		width={200}
		height={60}
		class="h-14 w-auto md:h-16"
	/>
</a>
