---
import { siteData } from "@/data/site";

// Shown under every guide. Fill in siteData.author (name, bio, image, sameAs) to make it personal.
const { author, social } = siteData;
const isPerson = author.type === "Person";
const initials = author.name
	.split(/\s+/)
	.map((w) => w[0])
	.join("")
	.slice(0, 2)
	.toUpperCase();
---

<aside class="nb-card mt-10 max-w-2xl bg-white p-5" aria-label="About this guide">
	<div class="flex items-start gap-4">
		{
			author.image ? (
				<img src={author.image} alt="" width="56" height="56" loading="lazy" class="h-14 w-14 shrink-0 rounded-full border-2 border-ink object-cover" />
			) : (
				<span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-sun font-mono text-lg font-bold text-ink" aria-hidden="true">
					{initials}
				</span>
			)
		}
		<div class="min-w-0">
			<p class="font-mono text-xs font-bold uppercase text-muted">{isPerson ? "Written by" : "Published by"}</p>
			<p class="text-lg font-bold leading-tight text-ink">
				<a href="/about/" class="underline decoration-2 underline-offset-4 hover:bg-sun">{author.name}</a>
				{isPerson && author.jobTitle && <span class="text-sm font-medium text-body"> · {author.jobTitle}</span>}
			</p>
			{author.bio && <p class="mt-2 text-sm leading-relaxed text-body">{author.bio}</p>}
			<p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-bold">
				<a href="/editorial-policy/" class="text-flame-dark underline hover:bg-sun hover:text-ink">How we verify and update guides</a>
				<a href="/contact/" class="text-flame-dark underline hover:bg-sun hover:text-ink">Report a mistake</a>
				{
					author.sameAs.map((href) => (
						<a href={href} rel="me noopener noreferrer" target="_blank" class="text-flame-dark underline hover:bg-sun hover:text-ink">
							{new URL(href).hostname.replace(/^www\./, "")}
						</a>
					))
				}
			</p>
		</div>
	</div>
</aside>
