---
import { siteData } from "@/data/site";
import ThemeToggle from "@/components/ThemeToggle.astro";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="sticky top-0 z-40 glass-bar border-b border-line">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 md:px-6">
		<a href="/" class="flex items-center gap-3" aria-label={`${siteData.name} home`}>
			<img src={siteData.logo.small} alt="" width="40" height="40" class="h-10 w-10 rounded-full" />
			<span class="text-lg font-bold tracking-tight text-ink">{siteData.name}</span>
		</a>

		<nav aria-label="Main" class="hidden md:block">
			<ul class="flex items-center gap-1 text-sm font-medium">
				{
					siteData.nav.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
								class:list={[
									"rounded-md px-3 py-2 transition-colors",
									isActive(item.href)
										? "bg-tint text-accent-strong"
										: "text-body hover:bg-soft hover:text-ink",
								]}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-2">
			<ThemeToggle />
			<a
				href="/#referral"
				class="hidden rounded-md bg-btn px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-btn-hover sm:inline-flex">
				Get the code
			</a>
			<button
				type="button"
				id="menu-button"
				class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-line text-ink md:hidden"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Open menu">
				<svg data-open aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
				<svg data-close aria-hidden="true" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="glass hidden border-t border-line md:hidden">
		<nav aria-label="Mobile" class="mx-auto max-w-6xl px-4 py-3">
			<ul class="space-y-1 font-medium">
				{
					siteData.nav.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
								class:list={[
									"block rounded-md px-3 py-3",
									isActive(item.href) ? "bg-tint text-accent-strong" : "text-body hover:bg-soft",
								]}>
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<a href="/#referral" class="mt-2 block rounded-md bg-btn px-3 py-3 text-center font-semibold text-white">
						Get the code
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	const button = document.getElementById("menu-button");
	const menu = document.getElementById("mobile-menu");

	function setOpen(open: boolean) {
		if (!button || !menu) return;
		button.setAttribute("aria-expanded", String(open));
		button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		menu.classList.toggle("hidden", !open);
		button.querySelector("[data-open]")?.classList.toggle("hidden", open);
		button.querySelector("[data-close]")?.classList.toggle("hidden", !open);
	}

	button?.addEventListener("click", () => {
		setOpen(button.getAttribute("aria-expanded") !== "true");
	});
	menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setOpen(false);
	});
</script>
