---
import { siteData } from "@/data/site";
import { getCategoryGroups } from "@/lib/posts";

interface Props {
	activeNav?: string;
}
const { activeNav } = Astro.props;

interface NavChild {
	label: string;
	/** full name for screen readers (the label "More" appears twice) */
	full: string;
	href: string;
	icon?: string;
	badge: string;
}
interface NavGroup {
	label: string;
	items: NavChild[];
}
interface NavItem {
	label: string;
	href: string;
	groups?: NavGroup[];
}

// The "Guide" item gets a dropdown with labelled groups (Banks & E-Wallets, Internet Providers).
// Each entry is a category with inNav: true (src/data/categories.ts). Empty categories stay hidden until their first post.
const groups: NavGroup[] = getCategoryGroups({ onlyNav: true }).map((g) => ({
	label: g.label,
	items: g.categories.map((c) => ({
		label: c.shortName ?? c.name,
		full: c.name,
		href: c.path,
		icon: c.logo,
		badge: c.badge ?? c.name.charAt(0),
	})),
}));
const nav: NavItem[] = siteData.nav.map((item) => ({
	label: item.label,
	href: item.href,
	groups: "dropdown" in item && groups.length ? groups : undefined,
}));

const path = Astro.url.pathname;
const isActive = (href: string) => (activeNav ? href === activeNav : href === "/" ? path === "/" : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b-[3px] border-ink bg-paper">
	<div class="mx-auto flex h-[4.25rem] max-w-6xl items-center justify-between gap-4 px-4 md:px-6">
		<a href="/" class="group flex min-w-0 shrink-0 items-center gap-2.5 sm:gap-3" aria-label={`${siteData.name} home`}>
			<img
				src={siteData.logo.small}
				alt=""
				width="44"
				height="44"
				class="h-10 w-10 rounded-full transition-transform group-hover:-rotate-12 sm:h-11 sm:w-11" />
			<span class="text-lg font-bold uppercase leading-none tracking-tight text-ink sm:text-xl">
				Pinoy<span class="ml-1 bg-ink px-1.5 py-0.5 text-sun">Techie</span>
			</span>
		</a>

		<nav aria-label="Main" class="relative hidden xl:block">
			<ul class="flex items-center gap-1.5 text-sm font-bold">
				{
					nav.map((item) => (
						<li class="group">
							<a
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
								aria-haspopup={item.groups ? "true" : undefined}
								class:list={[
									"flex items-center gap-1.5 whitespace-nowrap rounded-md border-2 px-3 py-1.5 transition-colors",
									isActive(item.href)
										? "border-ink bg-sun shadow-hard-sm"
										: "border-transparent hover:border-ink hover:bg-sun-soft group-focus-within:border-ink group-focus-within:bg-sun-soft",
								]}>
								{item.label}
								{item.groups && (
									<svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square" class="transition-transform group-hover:rotate-180 group-focus-within:rotate-180">
										<path d="M5 9l7 7 7-7" />
									</svg>
								)}
							</a>
							{item.groups && (
								<div class="invisible absolute right-0 top-full z-50 w-max max-w-[calc(100vw-2rem)] pt-2 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
									<div class="flex max-h-[calc(100vh-6rem)] items-start gap-2 overflow-y-auto rounded-lg border-[3px] border-ink bg-cream p-2 shadow-hard">
										{item.groups.map((group, gi) => (
											<section aria-label={group.label} class:list={["min-w-56 flex-1", gi > 0 && "border-l-2 border-dashed border-ink pl-2"]}>
												<p class="px-3 pb-1 pt-1 font-mono text-[0.7rem] font-bold uppercase tracking-wider text-ink/70">{group.label}</p>
												<ul class="space-y-1">
													{group.items.map((child) => (
														<li>
															<a
																href={child.href}
																aria-label={child.full}
																aria-current={path.startsWith(child.href) ? "page" : undefined}
																class:list={[
																	"flex items-center gap-3 whitespace-nowrap rounded-md border-2 px-3 py-2 transition-colors",
																	path.startsWith(child.href) ? "border-ink bg-sun" : "border-transparent hover:border-ink hover:bg-sun-soft",
																]}>
																{child.icon ? (
																	<img src={child.icon} alt="" width="28" height="28" class="h-7 w-7 rounded-md border-2 border-ink bg-white" />
																) : (
																	<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md border-2 border-ink bg-ink font-mono text-sm font-bold text-sun" aria-hidden="true">
																		{child.badge}
																	</span>
																)}
																{child.label}
															</a>
														</li>
													))}
												</ul>
											</section>
										))}
									</div>
								</div>
							)}
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-3">
			<a href="/search/" class="nb-btn nb-btn-white !p-0 h-11 w-11" aria-label="Search guides">
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L21 21"></path></svg>
			</a>
			<a href="/#referral" class="nb-btn nb-btn-red nb-btn-sm hidden shrink-0 whitespace-nowrap sm:inline-flex">Get the code</a>
			<button
				type="button"
				id="menu-button"
				class="nb-btn nb-btn-white !p-0 h-11 w-11 xl:hidden"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Open menu">
				<svg data-open aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
				<svg data-close aria-hidden="true" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square"><path d="M6 6l12 12M18 6L6 18"></path></svg>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="hidden border-t-[3px] border-ink bg-sun xl:hidden">
		<nav aria-label="Mobile" class="mx-auto max-w-6xl px-4 py-4">
			<ul class="space-y-2 font-bold">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
								class:list={[
									"flex items-center gap-3 rounded-md border-2 border-ink px-4 py-3",
									isActive(item.href) ? "bg-ink text-sun" : "bg-white",
								]}>
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<a href="/#referral" class="nb-btn nb-btn-red mt-2 w-full">Get the code</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	const button = document.getElementById("menu-button");
	const menu = document.getElementById("mobile-menu");

	function setOpen(open: boolean) {
		if (!button || !menu) return;
		button.setAttribute("aria-expanded", String(open));
		button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		menu.classList.toggle("hidden", !open);
		button.querySelector("[data-open]")?.classList.toggle("hidden", open);
		button.querySelector("[data-close]")?.classList.toggle("hidden", !open);
	}

	button?.addEventListener("click", () => {
		setOpen(button.getAttribute("aria-expanded") !== "true");
	});
	menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setOpen(false);
	});
</script>
