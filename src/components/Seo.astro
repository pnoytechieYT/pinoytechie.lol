---
import { siteData } from "@/data/site";
import { abs, baseGraph } from "@/lib/seo";

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: "website" | "article";
	publishedTime?: string;
	modifiedTime?: string;
	tags?: string[];
	noindex?: boolean;
	/** Extra schema.org nodes for this page (WebPage, BlogPosting, FAQPage, BreadcrumbList...) */
	schema?: Record<string, unknown>[];
}

const {
	title,
	description,
	image = siteData.ogImage,
	imageAlt = siteData.ogImageAlt,
	type = "website",
	publishedTime,
	modifiedTime,
	tags = [],
	noindex = false,
	schema = [],
} = Astro.props;

// Canonical: absolute, always with a trailing slash for page URLs.
let pathname = Astro.url.pathname;
if (!pathname.endsWith("/") && !/\.[a-z0-9]+$/i.test(pathname)) pathname += "/";
const canonical = new URL(pathname, Astro.site).toString();
const imageUrl = abs(image);

const graph = { "@context": "https://schema.org", "@graph": [...baseGraph(), ...schema] };
const jsonLd = JSON.stringify(graph).replace(/</g, "\\u003c");

const robots = noindex
	? "noindex, follow"
	: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />

	<title>{title}</title>
	<meta name="description" content={description} />
	<meta name="robots" content={robots} />
	<meta name="author" content={siteData.author.name} />
	<link rel="canonical" href={canonical} />
	<link rel="alternate" hreflang={siteData.locale} href={canonical} />
	<link rel="alternate" type="application/rss+xml" title={`${siteData.name} RSS feed`} href="/rss.xml" />
	<link rel="sitemap" href="/sitemap-index.xml" />

	<meta name="theme-color" content="#eaf1ff" />
	<script is:inline>
		// Runs before first paint so there is no light/dark flash. Choice: "system" (default) | "light" | "dark".
		(function () {
			var root = document.documentElement;
			var mq = window.matchMedia("(prefers-color-scheme: dark)");
			function pref() {
				try { return localStorage.getItem("theme") || "system"; } catch (e) { return "system"; }
			}
			function apply() {
				var p = pref();
				var dark = p === "dark" || (p === "system" && mq.matches);
				root.classList.toggle("dark", dark);
				root.dataset.theme = p;
				var m = document.querySelector('meta[name="theme-color"]');
				if (m) m.setAttribute("content", dark ? "#060d1f" : "#eaf1ff");
			}
			window.__applyTheme = apply;
			apply();
			if (mq.addEventListener) mq.addEventListener("change", apply);
		})();
	</script>
	<link rel="icon" href="/favicon.ico" sizes="48x48" />
	<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
	<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
	<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	<link rel="manifest" href="/site.webmanifest" />

	<meta property="og:type" content={type} />
	<meta property="og:site_name" content={siteData.name} />
	<meta property="og:locale" content="en_PH" />
	<meta property="og:url" content={canonical} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={imageUrl} />
	<meta property="og:image:alt" content={imageAlt} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	{publishedTime && <meta property="article:published_time" content={publishedTime} />}
	{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
	{type === "article" && <meta property="article:author" content={siteData.author.name} />}
	{type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={imageUrl} />
	<meta name="twitter:image:alt" content={imageAlt} />

	<script type="application/ld+json" set:html={jsonLd} />

	{siteData.googleSiteVerification && (
		<meta name="google-site-verification" content={siteData.googleSiteVerification} />
	)}
</head>
