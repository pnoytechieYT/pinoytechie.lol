---
import PostRow from "@/components/ui/PostRow.astro";
import { getPosts } from "@/lib/posts";

const posts = getPosts().slice(0, 3);
---

{
	posts.length > 0 && (
		<section class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20" aria-labelledby="posts-title">
			<div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
				<h2 id="posts-title" class="font-display text-3xl font-extrabold tracking-tight md:text-4xl">
					Read before you sign up
				</h2>
				<a href="/blog/" class="font-semibold underline decoration-promo decoration-4 underline-offset-4">
					All posts
				</a>
			</div>
			<div class="border-b border-line">
				{posts.map((post) => <PostRow post={post} />)}
			</div>
		</section>
	)
}
