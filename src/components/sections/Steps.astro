---
import { siteData } from "@/data/site";

// Pin colours and the height (rem) where each pin's tip sits on the dotted route.
// The same numbers are used in the SVG path below (x: 100 / 300 / 500 of 600, y in 1/16 rem).
const pins = [
	{ tip: 5.4, bg: "var(--color-sun)", ink: "var(--color-ink)" },
	{ tip: 7.7, bg: "var(--color-amber)", ink: "var(--color-ink)" },
	{ tip: 5.0, bg: "var(--color-flame-deep)", ink: "#fff" },
];
---

<section id="how-it-works" class="map-paper relative overflow-hidden border-y-[3px] border-ink" aria-labelledby="steps-title">
	<!-- compass -->
	<svg aria-hidden="true" class="pointer-events-none absolute right-6 top-8 hidden h-24 w-24 lg:block xl:h-28 xl:w-28" viewBox="0 0 100 100" fill="none" stroke="#111" stroke-width="3">
		<circle cx="50" cy="50" r="40" fill="#fff"></circle>
		<circle cx="50" cy="50" r="31" stroke-dasharray="1 7" stroke-linecap="round"></circle>
		<polygon points="50,14 59,50 50,44 41,50" fill="#e11d00" stroke-linejoin="round"></polygon>
		<polygon points="50,86 41,50 50,56 59,50" fill="#ffea00" stroke-linejoin="round"></polygon>
		<text x="50" y="11" text-anchor="middle" font-family="Space Mono, monospace" font-weight="700" font-size="13" fill="#111" stroke="none">N</text>
	</svg>

	<div class="mx-auto max-w-6xl px-4 py-12 sm:py-16 md:px-6 md:py-24">
		<div class="max-w-2xl">
			<span class="nb-tag nb-tag-dark">Your route</span>
			<h2 id="steps-title" class="mt-4 text-3xl font-bold leading-[1.05] tracking-tight text-ink sm:text-4xl md:text-5xl">
				How to get the <span class="hl">{siteData.referral.bonus}</span>
			</h2>
			<p class="mt-4 text-lg font-medium text-body">
				Three stops. The reward arrives after the {siteData.referral.holdDays}-day hold.
			</p>
		</div>

		<div class="relative mt-14 md:mt-12">
			<!-- Desktop: dotted route across the three stops -->
			<div class="pointer-events-none absolute inset-x-0 top-0 hidden h-[10.5rem] md:block" aria-hidden="true">
				<svg class="h-full w-full" viewBox="0 0 600 168" preserveAspectRatio="none">
					<path class="map-route" d="M0 115 C 40 115, 60 86, 100 86 S 220 123, 300 123 S 440 80, 500 80 S 570 100, 600 100"></path>
				</svg>
				<span class="absolute left-0 top-[7.19rem] -translate-y-1/2 border-2 border-ink bg-ink px-2 py-1 font-mono text-xs font-bold uppercase tracking-widest text-sun">Start</span>
				<span class="absolute right-0 top-[4.55rem] flex h-[3.6rem] w-[3.6rem] -rotate-6 items-center justify-center rounded-full border-[3px] border-ink bg-gold font-mono text-sm font-bold leading-none text-ink shadow-hard-sm">{siteData.referral.bonus}</span>
			</div>

			<ol class="relative grid md:grid-cols-3">
				{
					siteData.steps.map((step, i) => (
						<li class="relative pb-8 pl-[4.5rem] md:px-3 md:pb-0 md:pl-3 md:pt-[10.5rem]" style={`--pin:${pins[i].bg};--pin-ink:${pins[i].ink}`}>
							<!-- mobile pin -->
							<span class="map-dot absolute left-0 top-5 md:hidden" aria-hidden="true"><span>{i + 1}</span></span>
							{i < siteData.steps.length - 1 && <span class="map-drop absolute bottom-[-1.1rem] left-[1.4rem] top-[4.5rem] md:hidden" aria-hidden="true"></span>}
							<!-- desktop pin + dotted drop line down to the card -->
							<div class="absolute inset-x-0 top-0 hidden h-[10.5rem] md:block" aria-hidden="true">
								<span class="map-drop absolute left-1/2 -ml-0.5 bottom-0" style={`top:${pins[i].tip}rem`}></span>
								<span class="map-pin absolute left-1/2 -ml-[1.55rem]" style={`top:${pins[i].tip - 3.74}rem`}><span>{i + 1}</span></span>
							</div>
							<div class:list={["nb-card relative p-6", i === 2 ? "bg-sun" : "bg-white"]}>
								<h3 class="text-xl font-bold leading-snug tracking-tight text-ink">{step.title}</h3>
								<p class="mt-3 leading-relaxed text-body">{step.description}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>
