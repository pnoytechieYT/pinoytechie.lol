---
import { siteData } from "@/data/site";
---

<section id="how-it-works" class="bg-slate-50" aria-labelledby="steps-title">
	<div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-wider text-brand-600">How it works</p>
			<h2 id="steps-title" class="mt-2 text-3xl font-bold tracking-tight text-navy-900 md:text-4xl">
				How to get the {siteData.referral.bonus}
			</h2>
			<p class="mt-3 text-lg text-slate-600">
				Three steps. The reward arrives after the {siteData.referral.holdDays}-day hold.
			</p>
		</div>
		<ol class="mt-10 grid gap-6 md:grid-cols-3">
			{
				siteData.steps.map((step, i) => (
					<li class="relative rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
						<span class="flex h-10 w-10 items-center justify-center rounded-full bg-navy-900 text-lg font-bold text-gold-400">
							{i + 1}
						</span>
						<h3 class="mt-5 text-lg font-semibold text-navy-900">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-600">{step.description}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
