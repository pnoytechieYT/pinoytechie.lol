---
import YouTubeEmbed from "@/components/YouTubeEmbed.astro";
import { siteData } from "@/data/site";
import { homeVideo } from "@/data/videos";

const { video, social } = siteData;
---

<section class="glass" aria-labelledby="video-title">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-12 md:items-center md:px-6 md:py-20">
		<div class="md:col-span-5">
			<p class="text-sm font-semibold uppercase tracking-wider text-accent">Video</p>
			<h2 id="video-title" class="mt-2 text-3xl font-bold tracking-tight text-ink md:text-4xl">{video.heading}</h2>
			<p class="mt-3 text-lg leading-relaxed text-body">{video.text}</p>
			<div class="mt-6 flex flex-wrap gap-3">
				{
					social.youtube && (
						<a
							href={social.youtube}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center rounded-md bg-btn px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-btn-hover">
							Subscribe on YouTube
						</a>
					)
				}
				<a
					href="/videos/"
					class="inline-flex items-center rounded-md border border-line px-5 py-3 text-sm font-semibold text-ink transition-colors hover:bg-soft">
					More videos
				</a>
			</div>
		</div>
		<div class="md:col-span-7">
			<YouTubeEmbed id={homeVideo.id} si={homeVideo.si} title={homeVideo.title} />
		</div>
	</div>
</section>
