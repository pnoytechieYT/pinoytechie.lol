---
import YouTubeEmbed from "@/components/YouTubeEmbed.astro";
import { siteData } from "@/data/site";

const { video, social } = siteData;
---

<section class="bg-white" aria-labelledby="video-title">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-12 md:items-center md:px-6 md:py-20">
		<div class="md:col-span-5">
			<p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Video</p>
			<h2 id="video-title" class="mt-2 text-3xl font-bold tracking-tight text-navy-900 md:text-4xl">{video.heading}</h2>
			<p class="mt-3 text-lg leading-relaxed text-slate-600">{video.text}</p>
			<div class="mt-6 flex flex-wrap gap-3">
				{
					social.youtube && (
						<a
							href={social.youtube}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center rounded-md bg-navy-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-navy-700">
							Subscribe on YouTube
						</a>
					)
				}
				<a
					href="/videos/"
					class="inline-flex items-center rounded-md border border-slate-300 px-5 py-3 text-sm font-semibold text-navy-900 transition-colors hover:bg-slate-50">
					More videos
				</a>
			</div>
		</div>
		<div class="md:col-span-7">
			<YouTubeEmbed si={video.si} />
		</div>
	</div>
</section>
