---
import StoreButton from "@/components/StoreButton.astro";
import CopyButton from "@/components/CopyButton.astro";
import { siteData } from "@/data/site";
---

<section id="download" class="hero-bg text-white" aria-labelledby="download-title">
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 md:grid-cols-12 md:items-center md:px-6 md:py-20">
		<div class="md:col-span-7">
			<h2 id="download-title" class="text-3xl font-bold leading-tight tracking-tight md:text-4xl">
				Open your MariBank account with <span class="text-gold-400">{siteData.referral.code}</span>
			</h2>
			<p class="mt-3 max-w-xl text-lg text-slate-300">
				Use the official store links, then enter the code during sign-up.
			</p>
			<CopyButton code={siteData.referral.code} class="mt-6 !bg-gold-400 !text-navy-950 hover:!bg-gold-300" />
		</div>
		<div class="flex flex-wrap gap-4 md:col-span-5 md:justify-end">
			<StoreButton
				href="https://play.google.com/store/apps/details?id=ph.seabank.seabank&hl=en"
				src="/images/playstore-btn.webp"
				alt="Get it on Google Play"
				label="Download MariBank from Google Play Store"
				width={1280}
				height={380}
			/>
			<StoreButton
				href="https://apps.apple.com/ph/app/maribank-ph-seabank/id1592249158"
				src="/images/appstore-btn.webp"
				alt="Download on the App Store"
				label="Download MariBank from Apple App Store"
				width={800}
				height={237}
			/>
		</div>
	</div>
</section>
