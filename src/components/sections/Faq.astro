---
import { siteData } from "@/data/site";
---

<section class="border-y-[3px] border-ink bg-sun-soft" aria-labelledby="faq-title">
	<div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-12 md:px-6 md:py-24">
		<div class="md:col-span-4">
			<div class="md:sticky md:top-28">
				<span class="nb-tag nb-tag-dark">FAQ</span>
				<h2 id="faq-title" class="mt-4 text-4xl font-bold leading-[1.05] tracking-tight text-ink md:text-5xl">Common questions</h2>
				<p class="mt-4 font-medium text-body">
					Short answers about the referral code. For anything else, read our
					<a href="/blog/" class="font-bold text-flame-dark underline decoration-2 underline-offset-4 hover:bg-sun hover:text-ink">guides</a>.
				</p>
			</div>
		</div>
		<div class="space-y-4 md:col-span-8">
			{
				siteData.faqs.map((faq) => (
					<details class="group nb-card open:bg-sun open:shadow-hard-lg [&_summary::-webkit-details-marker]:hidden">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-lg font-bold leading-snug text-ink">
							{faq.question}
							<span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center border-[3px] border-ink bg-white font-mono text-2xl font-bold leading-none transition-transform group-open:rotate-45 group-open:bg-ink group-open:text-sun">
								+
							</span>
						</summary>
						<p class="border-t-[3px] border-dashed border-ink px-5 pb-5 pt-4 font-medium leading-relaxed text-body">{faq.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
