---
import { siteData } from "@/data/site";
---

<section class="border-t border-line bg-white" aria-labelledby="faq-title">
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-12 md:px-6 md:py-20">
		<h2 id="faq-title" class="font-display text-3xl font-extrabold leading-tight tracking-tight md:col-span-4 md:text-4xl">
			Common questions
		</h2>
		<div class="divide-y divide-line border-y border-line md:col-span-8">
			{
				siteData.faqs.map((faq) => (
					<details class="group py-5">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold [&::-webkit-details-marker]:hidden">
							{faq.question}
							<span aria-hidden="true" class="text-3xl font-medium leading-none text-promo transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 max-w-2xl font-text text-slate">{faq.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
