---
import { siteData } from "@/data/site";

const { referral } = siteData;
const asOf = new Date(referral.usersCountAsOf).toLocaleDateString(siteData.locale, {
	month: "long",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
});

const items = [
	{ value: "₱1,000,000", label: "PDIC deposit insurance per depositor" },
	{ value: "Licensed", label: "Digital bank in the Philippines" },
	{ value: referral.usersCount.toLocaleString(siteData.locale), label: `People used this code (as of ${asOf})` },
	{ value: "Independent", label: "Not affiliated with MariBank" },
];
---

<section aria-label="Key facts">
	<dl class="mx-auto grid max-w-6xl grid-cols-2 gap-4 px-4 py-8 md:grid-cols-4 md:px-6">
		{
			items.map((item) => (
				<div class="glass rounded-2xl border border-line px-4 py-6 text-center md:px-6">
					<dt class="sr-only">{item.label}</dt>
					<dd class="text-2xl font-bold tracking-tight text-ink md:text-3xl">{item.value}</dd>
					<p class="mt-1 text-xs text-muted md:text-sm" aria-hidden="true">{item.label}</p>
				</div>
			))
		}
	</dl>
</section>
