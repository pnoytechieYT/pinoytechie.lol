---
import { siteData } from "@/data/site";

const { referral } = siteData;
const asOf = new Date(referral.usersCountAsOf).toLocaleDateString(siteData.locale, {
	month: "long",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
});

const fmt = new Intl.NumberFormat(siteData.locale);

// count: the number animates from 0 up to this value when it scrolls into view.
const items: { value: string; count?: number; prefix?: string; label: string; bg: string }[] = [
	{ value: "₱1,000,000", count: 1_000_000, prefix: "₱", label: "PDIC deposit insurance per depositor", bg: "bg-sun" },
	{ value: "Licensed", label: "Digital bank in the Philippines", bg: "bg-white" },
	{ value: fmt.format(referral.usersCount), count: referral.usersCount, label: `People used this code (as of ${asOf})`, bg: "bg-amber" },
	{ value: "Independent", label: "Not affiliated with MariBank", bg: "bg-white" },
];
---

<section aria-label="Key facts">
	<dl class="mx-auto grid max-w-6xl grid-cols-1 gap-5 px-4 py-10 sm:grid-cols-2 sm:py-12 md:gap-6 md:px-6 lg:grid-cols-4">
		{
			items.map((item, i) => (
				<div class:list={["nb-card min-w-0 px-3 py-6 text-center md:px-5", item.bg, i % 2 === 0 ? "md:-rotate-1" : "md:rotate-1"]}>
					<dt class="sr-only">{item.label}</dt>
					<dd class="text-2xl font-bold tracking-tight text-ink md:text-3xl lg:text-2xl xl:text-3xl">
						{item.count !== undefined ? (
							<>
								<span class="sr-only">{item.value}</span>
								<span aria-hidden="true" class="inline-block tabular-nums" data-count-to={item.count} data-count-prefix={item.prefix ?? ""}>{item.value}</span>
							</>
						) : (
							item.value
						)}
					</dd>
					<p class="mt-2 font-mono text-[0.7rem] font-bold uppercase leading-snug tracking-wide text-ink/80 md:text-xs" aria-hidden="true">{item.label}</p>
				</div>
			))
		}
	</dl>
</section>

<script>
	// Count-up: starts when the number scrolls into view. Without JS, or with
	// "reduce motion" turned on, the final number is simply shown.
	const els = document.querySelectorAll<HTMLElement>("[data-count-to]");
	const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (els.length && !reduce && "IntersectionObserver" in window) {
		const fmt = new Intl.NumberFormat("en-PH");
		const show = (el: HTMLElement, n: number) => (el.textContent = `${el.dataset.countPrefix ?? ""}${fmt.format(Math.round(n))}`);
		const DURATION = 1800;

		const run = (el: HTMLElement) => {
			const target = Number(el.dataset.countTo);
			const t0 = performance.now();
			const tick = (now: number) => {
				const p = Math.min(1, (now - t0) / DURATION);
				const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p); // fast at first, slows near the end
				show(el, target * eased);
				if (p < 1) requestAnimationFrame(tick);
				else el.classList.add("count-pop");
			};
			requestAnimationFrame(tick);
		};

		els.forEach((el) => show(el, 0));
		const io = new IntersectionObserver(
			(entries) =>
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					io.unobserve(entry.target);
					run(entry.target as HTMLElement);
				}),
			{ threshold: 0.6 },
		);
		els.forEach((el) => io.observe(el));
	}
</script>
