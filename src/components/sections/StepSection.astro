---
import { siteData } from "@/data/site";
---

<section id="how-it-works" class="border-y border-line bg-white" aria-labelledby="steps-title">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-12 md:px-6 md:py-20">
		<div class="md:col-span-4">
			<h2 id="steps-title" class="font-display text-3xl font-extrabold leading-tight tracking-tight md:text-4xl">
				How to get the {siteData.referral.bonus}
			</h2>
			<p class="mt-3 font-text text-slate">
				Three steps. The reward arrives after the {siteData.referral.holdDays}-day hold.
			</p>
		</div>
		<ol class="divide-y divide-line border-y border-line md:col-span-8">
			{
				siteData.steps.map((step, i) => (
					<li class="grid grid-cols-[3.5rem_1fr] gap-4 py-6 md:grid-cols-[4.5rem_1fr]">
						<span class="font-display text-5xl font-extrabold leading-none text-promo md:text-6xl">
							{i + 1}
						</span>
						<div>
							<h3 class="font-display text-xl font-bold md:text-2xl">{step.title}</h3>
							<p class="mt-1 font-text text-slate">{step.description}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
