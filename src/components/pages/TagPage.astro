---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import PostListing from "@/components/PostListing.astro";
import { siteData } from "@/data/site";
import { getPosts, getTags, slugify } from "@/lib/posts";
import { paginate, pageUrl } from "@/lib/pagination";
import { breadcrumbNode, webPageNode } from "@/lib/seo";

/** All guides with one tag, paginated, then the other topic tags. */
interface Props {
	slug: string;
	page: number;
}
const { slug, page } = Astro.props;

const tag = getTags().find((t) => t.slug === slug)!;
const posts = getPosts().filter((p) => p.tags.some((t) => slugify(t) === slug));
const result = paginate(posts, page, siteData.paging.postsPerPage);
const otherTags = getTags().filter((t) => t.slug !== slug);

const base = `/blog/tag/${slug}/`;
const path = pageUrl(base, result.page);
const suffix = result.page > 1 ? ` (page ${result.page})` : "";
const title = `${tag.name} guides${suffix}`;
const description = `All Pinoy Techie guides tagged "${tag.name}": ${posts.length} plain-language article${posts.length === 1 ? "" : "s"} on MariBank and digital banking in the Philippines.`;
const crumbs = [
	{ name: "Home", href: "/" },
	{ name: "Guides", href: "/blog/" },
	{ name: tag.name, href: base },
];

// Thin archives stay out of the index.
const noindex = posts.length < 3;
---

<BaseLayout
	title={title}
	description={description}
	noindex={noindex}
	schema={[webPageNode({ type: "CollectionPage", path, title, description }), breadcrumbNode(crumbs)]}>
	<PageHero title={`${tag.name} guides`} lead={`${posts.length} article${posts.length === 1 ? "" : "s"} about ${tag.name}.`} crumbs={crumbs} />
	<div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
		<PostListing result={result} basePath={base} tags={otherTags} />
		<p class="mt-12">
			<a href="/blog/" class="nb-btn nb-btn-white">← All guides</a>
		</p>
	</div>
</BaseLayout>
