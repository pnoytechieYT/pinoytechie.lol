---
import CopyButton from "@/components/CopyButton.astro";
import { siteData } from "@/data/site";

interface Props {
	code: string;
	bonus: string;
	minDeposit: string;
	holdDays: number;
	/** Smaller version for the article sidebar */
	compact?: boolean;
}
const { code, bonus, minDeposit, holdDays, compact = false } = Astro.props;
---

<div class:list={["angpao", compact && "angpao-compact"]} role="group" aria-label="Referral code angpao">
	<div class="angpao-top">
		<p class="nb-tag nb-tag-dark inline-flex items-center gap-2 !py-1.5">
			<img src={siteData.maribankLogo} alt="" width="20" height="20" class="h-5 w-5 rounded border border-white/40 bg-white" />
			MariBank referral angpao
		</p>
		{!compact && <p class="angpao-headline">Enjoy your {bonus}</p>}
		<div class="angpao-note">
			<p class="font-mono text-[0.68rem] font-bold uppercase tracking-widest text-muted">Your MariBank referral code</p>
			<p class:list={["mt-2 break-all border-[3px] border-dashed border-ink bg-sun-soft px-2 py-3 text-center font-mono font-bold tracking-wider text-ink", compact ? "text-xl" : "text-2xl md:text-3xl"]}>
				{code}
			</p>
		</div>
	</div>

	<div class="angpao-seal-wrap">
		<CopyButton code={code} variant="seal" />
	</div>

	<div class="angpao-bottom">
		{
			compact ? (
				<p class="text-sm font-bold leading-snug">
					Deposit {minDeposit}, keep it {holdDays} days, get {bonus}.
				</p>
			) : (
				<>
					<p class="font-mono text-xs font-bold uppercase tracking-widest">Angpao from</p>
					<p class="text-2xl font-bold uppercase leading-none tracking-tight">Pinoy Techie</p>
					<dl class="mt-4 grid grid-cols-3 divide-x-[3px] divide-ink border-[3px] border-ink bg-cream text-center">
						<div class="px-1.5 py-2.5">
							<dt class="font-mono text-[0.62rem] font-bold uppercase tracking-wider text-muted">First deposit</dt>
							<dd class="mt-1 text-lg font-bold text-ink">{minDeposit}</dd>
						</div>
						<div class="px-1.5 py-2.5">
							<dt class="font-mono text-[0.62rem] font-bold uppercase tracking-wider text-muted">Keep it for</dt>
							<dd class="mt-1 text-lg font-bold text-ink">{holdDays} days</dd>
						</div>
						<div class="bg-ink px-1.5 py-2.5">
							<dt class="font-mono text-[0.62rem] font-bold uppercase tracking-wider text-sun">Reward</dt>
							<dd class="mt-1 text-lg font-bold text-sun">{bonus}</dd>
						</div>
					</dl>
				</>
			)
		}
	</div>
</div>
