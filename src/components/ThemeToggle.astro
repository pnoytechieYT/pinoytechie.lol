---
// System / Light / Dark switch. Choice is saved in localStorage ("theme") and applied by the inline script in Seo.astro.
const options = [
	{ value: "system", label: "System theme", path: "M4 5h16v10H4zM9 19h6M12 15v4" },
	{ value: "light", label: "Light theme", path: "M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z" },
	{ value: "dark", label: "Dark theme", path: "M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" },
];
---

<div class="theme-toggle glass inline-flex items-center gap-0.5 rounded-full border border-line p-0.5" role="group" aria-label="Color theme">
	{
		options.map((o) => (
			<button
				type="button"
				data-theme-option={o.value}
				aria-pressed="false"
				aria-label={o.label}
				title={o.label}
				class="inline-flex h-8 w-8 items-center justify-center rounded-full text-muted transition-colors hover:text-ink aria-pressed:bg-btn aria-pressed:text-white">
				<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d={o.path} />
				</svg>
			</button>
		))
	}
</div>

<script>
	function sync() {
		const current = document.documentElement.dataset.theme || "system";
		document.querySelectorAll<HTMLButtonElement>("[data-theme-option]").forEach((b) => {
			b.setAttribute("aria-pressed", String(b.dataset.themeOption === current));
		});
	}
	document.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-theme-option]");
		if (!btn) return;
		try {
			localStorage.setItem("theme", btn.dataset.themeOption!);
		} catch {}
		(window as any).__applyTheme?.();
		sync();
	});
	sync();
</script>
