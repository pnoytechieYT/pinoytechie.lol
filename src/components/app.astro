---
import "@/styles/global.css";
import Head from "@/components/includes/head.astro";
import Header from "@/components/includes/header.astro";
import Footer from "@/components/includes/footer.astro";

interface Props {
	title: string;
	description: string;
	image?: string;
	jsonLd?: Record<string, unknown>;
	type?: "website" | "article";
	publishedTime?: string;
	modifiedTime?: string;
	noindex?: boolean;
}

const props = Astro.props;
---

<html lang="en-PH">
	<Head {...props} />
	<body class="min-h-screen">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-sun focus:px-3 focus:py-2 focus:font-semibold"
		>
			Skip to content
		</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
