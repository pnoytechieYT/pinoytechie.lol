---
import { formatDate, type Post } from "@/lib/posts";

interface Props {
	post: Post;
}
const { post } = Astro.props;
---

<article class="group relative flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-100 hover:shadow-md">
	<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
		{post.tags.slice(0, 2).map((tag) => (
			<span class="rounded-full bg-brand-50 px-2.5 py-1 text-brand-700">{tag}</span>
		))}
		{post.isScheduled && (
			<span class="rounded-full bg-gold-300 px-2.5 py-1 text-navy-950">Scheduled (dev only)</span>
		)}
	</div>
	<h3 class="mt-4 text-lg font-semibold leading-snug text-navy-900">
		<a href={`/blog/${post.slug}/`} class="after:absolute after:inset-0 group-hover:text-brand-700">
			{post.meta.title}
		</a>
	</h3>
	<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{post.meta.description}</p>
	<p class="mt-5 flex items-center gap-3 text-xs font-medium text-slate-500">
		<time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
		<span aria-hidden="true">·</span>
		<span>{post.minutes} min read</span>
	</p>
</article>
