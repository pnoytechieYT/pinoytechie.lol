---
import { formatDate, type Post } from "@/lib/posts";

interface Props {
	post: Post;
}
const { post } = Astro.props;
---

<article class="group nb-card nb-card-lift relative flex h-full flex-col p-6 hover:bg-sun-soft">
	<div class="flex flex-wrap items-center gap-2">
		{post.tags.slice(0, 2).map((tag, i) => (
			<span class:list={["nb-tag", i === 1 && "nb-tag-white"]}>{tag}</span>
		))}
		{post.isScheduled && <span class="nb-tag nb-tag-red">Scheduled (dev only)</span>}
	</div>
	<h3 class="mt-4 text-xl font-bold leading-snug tracking-tight text-ink">
		<a href={`/blog/${post.slug}/`} class="after:absolute after:inset-0">
			{post.meta.title}
		</a>
	</h3>
	<p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-body">{post.meta.description}</p>
	<p class="mt-5 flex items-center gap-3 border-t-2 border-dashed border-ink pt-4 font-mono text-xs font-bold uppercase text-ink">
		<time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
		<span aria-hidden="true">/</span>
		<span>{post.minutes} min read</span>
		<span aria-hidden="true" class="ml-auto text-lg leading-none transition-transform group-hover:translate-x-1">→</span>
	</p>
</article>
