---
interface Props {
	href: string;
	src: string;
	alt: string;
	label: string;
	width: number;
	height: number;
}
const { href, src, alt, label, width, height } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={label}
	class="inline-flex transition-transform duration-100 hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0.5 active:translate-y-0.5">
	<img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="h-12 w-auto md:h-14" />
</a>
