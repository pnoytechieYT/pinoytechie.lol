---
import { siteData } from "@/data/site";

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? path === "/" : path.startsWith(href);
---

<header class="border-b border-line bg-white">
	<div
		class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
		<a
			href="/"
			class="flex items-center font-display text-xl font-extrabold tracking-tight">
			<span class="rounded-md bg-promo px-1.5 pb-0.5">Pinoy</span>
			<span class="ml-1 ">Techie</span>
		</a>
		<nav aria-label="Main">
			<ul class="flex items-center gap-1 text-sm font-semibold md:text-base">
				{
					siteData.nav.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
								class:list={[
									"rounded-full px-3 py-2 transition-colors",
									isActive(item.href)
										? "bg-ink text-white"
										: "hover:bg-fog",
								]}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
