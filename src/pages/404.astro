---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
	title="Page not found"
	description="This page doesn't exist. Go back to the MariBank referral code page or browse the guides."
	noindex>
	<div class="mx-auto max-w-3xl px-4 py-24 text-center md:py-32">
		<p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Error 404</p>
		<h1 class="mt-3 text-4xl font-bold tracking-tight text-navy-900 md:text-6xl">Page not found</h1>
		<p class="mt-4 text-lg text-slate-600">The link may be old or mistyped. Try one of these instead.</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a href="/" class="rounded-md bg-navy-900 px-6 py-3 font-semibold text-white transition-colors hover:bg-navy-700">MariBank referral code</a>
			<a href="/blog/" class="rounded-md border border-slate-300 px-6 py-3 font-semibold text-navy-900 transition-colors hover:bg-white">Browse guides</a>
		</div>
	</div>
</BaseLayout>
