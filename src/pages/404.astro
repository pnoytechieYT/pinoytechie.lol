---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
	title="Page not found"
	description="This page doesn't exist. Go back to the MariBank referral code page or browse the guides."
	noindex>
	<div class="mx-auto max-w-3xl px-4 py-20 text-center md:py-28">
		<p class="nb-tag nb-tag-red rotate-2">Error 404</p>
		<h1 class="mt-6 font-mono text-[6rem] font-bold leading-none tracking-tighter text-ink md:text-[10rem]">
			4<span class="inline-block -rotate-6 bg-sun px-2 shadow-hard-lg border-[3px] border-ink">0</span>4
		</h1>
		<p class="mt-8 text-3xl font-bold tracking-tight text-ink md:text-4xl">Page not found</p>
		<p class="mt-3 text-lg font-medium text-body">The link may be old or mistyped. Try one of these instead.</p>
		<div class="mt-9 flex flex-wrap justify-center gap-4">
			<a href="/" class="nb-btn nb-btn-red px-6 py-3.5">MariBank referral code</a>
			<a href="/blog/" class="nb-btn nb-btn-white px-6 py-3.5">Browse guides</a>
		</div>
	</div>
</BaseLayout>
