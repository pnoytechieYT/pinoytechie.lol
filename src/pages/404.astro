---
import App from "@/components/app.astro";
---

<App
	title="Page not found | Pinoy Techie"
	description="This page doesn't exist. Go back to the MariBank referral code page or browse the blog."
	noindex>
	<div class="mx-auto max-w-3xl px-4 py-24 md:py-32">
		<h1 class="font-display text-5xl font-extrabold tracking-tight md:text-7xl">Page not found</h1>
		<p class="mt-4 font-text text-xl text-slate">
			The link may be old or mistyped. Try one of these instead.
		</p>
		<div class="mt-8 flex flex-wrap gap-4">
			<a href="/" class="rounded-full bg-promo px-6 py-3 font-bold text-ink">MariBank referral code</a>
			<a href="/blog/" class="rounded-full border-2 border-ink px-6 py-3 font-bold">Read the blog</a>
		</div>
	</div>
</App>
