---
import App from "@/components/app.astro";
import PostRow from "@/components/ui/PostRow.astro";
import { getPosts } from "@/lib/posts";

const posts = getPosts();
---

<App
	title="MariBank Guides and Comparisons | Pinoy Techie"
	description="Plain-language guides on MariBank: is it legit, how it compares with GCash, rates, and how to get the most from the sign-up reward.">
	<div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-20">
		<h1 class="font-display text-4xl font-extrabold tracking-tight md:text-6xl">
			MariBank guides
		</h1>
		<p class="mt-4 max-w-xl font-text text-lg text-slate">
			Comparisons and how-tos for digital banking in the Philippines, written so you can
			decide before you deposit.
		</p>
		<div class="mt-10 border-b border-line">
			{posts.map((post) => <PostRow post={post} />)}
		</div>
		{
			posts.length === 0 && (
				<p class="mt-10 font-text text-slate">
					No posts yet. Add a Markdown file to <code>src/posts</code> and it shows up here.
				</p>
			)
		}
	</div>
</App>
