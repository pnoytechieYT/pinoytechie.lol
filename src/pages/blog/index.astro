---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import PostCard from "@/components/PostCard.astro";
import { getPosts, getTags } from "@/lib/posts";
import { abs, breadcrumbNode, webPageNode } from "@/lib/seo";

const posts = getPosts();
const tags = getTags(posts);

const title = "MariBank Guides and Comparisons";
const description =
	"Plain-language guides on MariBank: is it legit, how it compares with GCash, savings rates, fees, and how to get the most from the sign-up reward.";
const crumbs = [
	{ name: "Home", href: "/" },
	{ name: "Guides", href: "/blog/" },
];

const schema = [
	{
		...webPageNode({ type: "CollectionPage", path: "/blog/", title, description }),
		mainEntity: {
			"@type": "ItemList",
			itemListElement: posts.map((p, i) => ({
				"@type": "ListItem",
				position: i + 1,
				url: abs(`/blog/${p.slug}/`),
				name: p.meta.title,
			})),
		},
	},
	breadcrumbNode(crumbs),
];
---

<BaseLayout title={title} description={description} schema={schema}>
	<PageHero
		title="MariBank guides"
		lead="Comparisons and how-tos for digital banking in the Philippines, written so you can decide before you deposit."
		crumbs={crumbs}
	/>

	<div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
		{
			tags.length > 0 && (
				<nav aria-label="Filter by topic" class="mb-10 flex flex-wrap gap-2">
					{tags.map((tag) => (
						<a
							href={`/blog/tag/${tag.slug}/`}
							class="rounded-full border border-line glass px-3.5 py-1.5 text-sm font-medium text-body transition-colors hover:border-brand-500 hover:text-accent-strong">
							{tag.name} <span class="text-slate-400">{tag.count}</span>
						</a>
					))}
				</nav>
			)
		}

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => <PostCard post={post} />)}
		</div>

		{
			posts.length === 0 && (
				<p class="text-body">
					No posts yet. Add a Markdown file to <code>src/posts</code> and it shows up here.
				</p>
			)
		}
	</div>
</BaseLayout>
