---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import PostCard from "@/components/PostCard.astro";
import { getPosts, getTags, slugify } from "@/lib/posts";
import { breadcrumbNode, webPageNode } from "@/lib/seo";

export function getStaticPaths() {
	return getTags().map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = getPosts().filter((p) => p.tags.some((t) => slugify(t) === tag.slug));

const title = `${tag.name} guides`;
const description = `All Pinoy Techie guides tagged "${tag.name}": ${posts.length} plain-language article${posts.length === 1 ? "" : "s"} on MariBank and digital banking in the Philippines.`;
const path = `/blog/tag/${tag.slug}/`;
const crumbs = [
	{ name: "Home", href: "/" },
	{ name: "Guides", href: "/blog/" },
	{ name: tag.name, href: path },
];

// Thin archives stay out of the index.
const noindex = posts.length < 3;
---

<BaseLayout
	title={title}
	description={description}
	noindex={noindex}
	schema={[webPageNode({ type: "CollectionPage", path, title, description }), breadcrumbNode(crumbs)]}>
	<PageHero title={title} lead={`${posts.length} article${posts.length === 1 ? "" : "s"} about ${tag.name}.`} crumbs={crumbs} />
	<div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
		<p class="mt-10">
			<a href="/blog/" class="font-semibold text-brand-600 hover:text-brand-700">← All guides</a>
		</p>
	</div>
</BaseLayout>
