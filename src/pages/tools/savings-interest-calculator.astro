---
import PageLayout from "@/layouts/PageLayout.astro";
import { products, STALE_AFTER_DAYS, WITHHOLDING_TAX } from "@/data/rates";
import { estimate, peso } from "@/lib/interest";
import { formatAsOf, rowHtml, taxPercent } from "@/lib/calculator-view";

// The table is rendered once at build time for a default case, so it is in the HTML for Google and for visitors without JavaScript.
// The script below replaces it as soon as the visitor changes a number.
const DEFAULT = { amount: 50_000, months: 12 };
const now = new Date();
const ranked = products
	.filter((p) => !p.bestCase)
	.map((p) => ({ p, est: estimate(p, DEFAULT.amount, DEFAULT.months, false) }))
	.sort((a, b) => (b.est?.net ?? -1) - (a.est?.net ?? -1));
const initialRows = ranked.map(({ p, est }, i) => rowHtml(p, est, now, i === 0 && !!est)).join("");
const best = ranked[0];
const latestCheck = [...products].map((p) => p.asOf).sort().at(-1)!;
---

<PageLayout
	title="Savings Interest Calculator Philippines (After 20% Tax)"
	heading="Savings Interest Calculator (After 20% Tax)"
	description="Free savings interest calculator for the Philippines: compare MariBank, Maya and GCash GSave partner banks after the 20% tax. Every rate shows its date and source."
	lead="See what your savings earn in MariBank, Maya and GCash GSave partner banks. Every rate shows the date we checked it and where it comes from."
	path="/tools/savings-interest-calculator/"
	dateModified={`${latestCheck}T00:00:00${"+08:00"}`}
	prose={false}>
	<div class="grid gap-8 lg:grid-cols-[22rem_1fr] lg:items-start">
		<form id="calc" class="nb-card space-y-5 bg-white p-5" novalidate>
			<div>
				<label for="amount" class="block font-mono text-sm font-bold uppercase text-ink">How much do you save? (₱)</label>
				<input id="amount" name="amount" type="number" inputmode="decimal" min="1" step="any" value={DEFAULT.amount}
					class="mt-2 w-full rounded-md border-[3px] border-ink bg-cream px-3 py-2.5 text-lg font-bold text-ink shadow-hard-sm focus:outline-none focus:ring-4 focus:ring-sun" />
				<div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Quick amounts">
					{[10_000, 50_000, 100_000, 500_000].map((v) => (
						<button type="button" data-amount={v} class="rounded-md border-2 border-ink bg-white px-2.5 py-1 text-sm font-bold hover:bg-sun">{v.toLocaleString("en-PH")}</button>
					))}
				</div>
			</div>
			<div>
				<label for="months" class="block font-mono text-sm font-bold uppercase text-ink">For how many months?</label>
				<input id="months" name="months" type="number" inputmode="numeric" min="1" max="120" step="1" value={DEFAULT.months}
					class="mt-2 w-full rounded-md border-[3px] border-ink bg-cream px-3 py-2.5 text-lg font-bold text-ink shadow-hard-sm focus:outline-none focus:ring-4 focus:ring-sun" />
				<div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Quick periods">
					{[1, 3, 6, 12, 24].map((v) => (
						<button type="button" data-months={v} class="rounded-md border-2 border-ink bg-white px-2.5 py-1 text-sm font-bold hover:bg-sun">{v} {v === 1 ? "month" : "months"}</button>
					))}
				</div>
			</div>
			<label class="flex items-start gap-3 text-sm font-medium text-body">
				<input id="compound" type="checkbox" class="mt-1 h-5 w-5 shrink-0 accent-black" />
				<span><strong class="text-ink">Keep the interest in the account.</strong> Each month's interest, after tax, is added to your balance (monthly compounding).</span>
			</label>
			<label class="flex items-start gap-3 text-sm font-medium text-body">
				<input id="best" type="checkbox" class="mt-1 h-5 w-5 shrink-0 accent-black" />
				<span><strong class="text-ink">Also show best-case promo rates.</strong> These depend on conditions and are not guaranteed.</span>
			</label>
			<p id="error" class="hidden text-sm font-bold text-flame-dark" role="alert"></p>
		</form>

		<div class="min-w-0">
			<p id="summary" class="nb-card bg-sun p-4 text-lg font-bold text-ink" aria-live="polite">
				{best.est && (
					<>
						On {peso(DEFAULT.amount)} for {DEFAULT.months} months, the highest after tax is <span class="underline decoration-2 underline-offset-4">{best.p.name}</span>:
						you keep about {peso(best.est.net)}. Limits and conditions apply, see the notes below.
					</>
				)}
			</p>
			<div class="mt-5 overflow-x-auto rounded-md border-[3px] border-ink bg-white shadow-hard-sm">
				<table class="w-full min-w-[56rem] border-collapse text-left text-sm">
					<caption class="sr-only">Interest earned after the {taxPercent}% withholding tax, by savings product</caption>
					<thead class="bg-ink text-sun">
						<tr class="font-mono text-xs uppercase">
							<th scope="col" class="px-3 py-2.5">Product</th>
							<th scope="col" class="px-3 py-2.5 text-right">Rate / year</th>
							<th scope="col" class="px-3 py-2.5 text-right">Interest before tax</th>
							<th scope="col" class="px-3 py-2.5 text-right">{taxPercent}% tax</th>
							<th scope="col" class="px-3 py-2.5 text-right">You keep</th>
							<th scope="col" class="px-3 py-2.5">Details and source</th>
						</tr>
					</thead>
					<tbody id="rows" set:html={initialRows} />
				</table>
			</div>
			<p class="mt-3 text-sm text-muted">
				Rates last checked {formatAsOf(latestCheck)}. Without JavaScript, this table shows {peso(DEFAULT.amount)} for {DEFAULT.months} months.
			</p>
		</div>
	</div>

	<div class="prose-article mt-14 max-w-3xl">
		<h2>How this calculator works</h2>
		<p>
			It is an estimate, not a promise. For each product it takes the rate, applies it to your balance for the number of months you choose, and then
			subtracts the {taxPercent}% withholding tax that Philippine banks deduct from deposit interest. The "You keep" column is what is left.
		</p>
		<ul>
			<li><strong>Tiered rates.</strong> MariBank pays 3.25% on the first ₱1,000,000 and 3.75% only on the part above it, so the calculator splits your balance. Other products pay one rate on the whole balance, chosen by how much you keep in.</li>
			<li><strong>Interest on interest.</strong> With the "keep the interest in the account" box ticked, each month's interest after tax is added to your balance. Without it, your balance stays the same, which is how most of our guides show examples.</li>
			<li><strong>Why your app may show a slightly different number.</strong> Banks credit interest daily or monthly, round differently, and use the exact number of days. Treat the result as a close estimate.</li>
		</ul>

		<h2>Where the rates come from</h2>
		<p>
			Every row shows the day we checked it and links to the page we checked: the bank's own page for MariBank and Maya, and the GCash Help Center for the GSave partner
			banks. A row that is more than {STALE_AFTER_DAYS} days old is flagged automatically so you know to confirm it in the app. Read our
			<a href="/editorial-policy/">verification process</a> for how we keep guides accurate.
		</p>
		<p>
			Rates change, and promos such as Maya's boost depend on conditions. Deposits in a bank are insured by the PDIC up to ₱1,000,000 per depositor per bank,
			but money in a GCash or Maya wallet is e-money and is not a bank deposit. This calculator is not financial advice.
		</p>

		<h2>Related guides</h2>
		<ul>
			<li><a href="/blog/maribank-savings-rate-guide/">MariBank savings rate: how the 3.25% and 3.75% tiers work</a></li>
			<li><a href="/blog/maribank-interest-calculation-10k-50k-100k/">MariBank interest on ₱10,000, ₱50,000 and ₱100,000</a></li>
			<li><a href="/blog/maya-savings-guide-interest-rate-and-how-to-start/">Maya Savings: interest rate, boosts and how to start</a></li>
			<li><a href="/blog/gcash-gsave-guide-rates-and-partner-banks/">GCash GSave: rates, partner banks and how to open</a></li>
			<li><a href="/blog/maribank-pdic-bsp-safety/">Is my money safe? PDIC and BSP explained</a></li>
		</ul>
	</div>
</PageLayout>

<script>
	import { products } from "@/data/rates";
	import { estimate, peso } from "@/lib/interest";
	import { rowHtml } from "@/lib/calculator-view";

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const amountEl = $<HTMLInputElement>("amount");
	const monthsEl = $<HTMLInputElement>("months");
	const compoundEl = $<HTMLInputElement>("compound");
	const bestEl = $<HTMLInputElement>("best");
	const rowsEl = $<HTMLElement>("rows");
	const summaryEl = $<HTMLElement>("summary");
	const errorEl = $<HTMLElement>("error");

	function update() {
		const amount = Number(amountEl.value);
		const months = Number(monthsEl.value);
		if (!(amount >= 1) || amount > 1_000_000_000) return fail("Enter an amount of at least ₱1.");
		if (!Number.isInteger(months) || months < 1 || months > 120) return fail("Enter a whole number of months from 1 to 120.");
		errorEl.classList.add("hidden");

		const now = new Date();
		const ranked = products
			.filter((p) => bestEl.checked || !p.bestCase)
			.map((p) => ({ p, est: estimate(p, amount, months, compoundEl.checked) }))
			.sort((a, b) => (b.est?.net ?? -1) - (a.est?.net ?? -1));
		// "Highest after tax" is only ever given to a normal rate, never to a best-case promo row.
		const top = ranked.find((r) => r.est && !r.p.bestCase);
		rowsEl.innerHTML = ranked.map((r) => rowHtml(r.p, r.est, now, !!top && r === top)).join("");
		summaryEl.textContent = top?.est
			? `On ${peso(amount)} for ${months} ${months === 1 ? "month" : "months"}, the highest after tax is ${top.p.name}: you keep about ${peso(top.est.net)}. Limits and conditions apply, see the notes below.`
			: "No product covers this amount. Check the apps for current rates.";
	}

	function fail(message: string) {
		errorEl.textContent = message;
		errorEl.classList.remove("hidden");
	}

	document.getElementById("calc")!.addEventListener("submit", (e) => e.preventDefault());
	[amountEl, monthsEl].forEach((el) => el.addEventListener("input", update));
	[compoundEl, bestEl].forEach((el) => el.addEventListener("change", update));
	document.querySelectorAll<HTMLButtonElement>("[data-amount]").forEach((b) =>
		b.addEventListener("click", () => {
			amountEl.value = b.dataset.amount!;
			update();
		}),
	);
	document.querySelectorAll<HTMLButtonElement>("[data-months]").forEach((b) =>
		b.addEventListener("click", () => {
			monthsEl.value = b.dataset.months!;
			update();
		}),
	);
</script>
