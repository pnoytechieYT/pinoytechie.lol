---
import PageLayout from "@/layouts/PageLayout.astro";
import { siteData } from "@/data/site";
import { formatDate } from "@/lib/posts";

const { name, referral, legalUpdated } = siteData;
const updated = formatDate(new Date(`${legalUpdated}T00:00:00${siteData.timezoneOffset}`));
---

<PageLayout
	title="Referral and Affiliate Disclosure"
	description="How Pinoy Techie earns from the MariBank referral code, why that does not change our guides, and what to know before you sign up."
	lead={`Last updated ${updated}`}
	path="/disclosure/"
	dateModified={`${legalUpdated}T00:00:00${siteData.timezoneOffset}`}>
	<h2>How we earn</h2>
	<p>
		{name} shares the MariBank referral code <strong>{referral.code}</strong>. When you sign up with it and meet MariBank's conditions,
		you can receive {referral.bonus} (first deposit of {referral.minDeposit}, kept for {referral.holdDays} days). Referral programs usually
		reward the person who shared the code as well, so we may earn a reward too. It costs you nothing extra.
	</p>

	<h2>Our guides stay independent</h2>
	<ul>
		<li>We write about the downsides and limits of a product, not only the benefits.</li>
		<li>We say when something is unverified or likely to change.</li>
		<li>Comparisons, such as <a href="/blog/maribank-vs-gcash/">MariBank vs GCash</a>, aim to help you pick what fits you, even when that is not MariBank.</li>
	</ul>

	<h2>What is outside our control</h2>
	<p>
		MariBank sets the reward amount, the deposit and holding rules and the eligibility, and can change or end the promo at any time.
		Check the terms inside the app before you deposit. We are not affiliated with MariBank or Sea Group.
	</p>

	<h2>No financial advice</h2>
	<p>Nothing here is financial advice. Only deposit money you are comfortable with, and read the provider's terms first.</p>

	<h2>Questions or corrections</h2>
	<p>See the <a href="/contact/">contact page</a>.</p>
</PageLayout>
