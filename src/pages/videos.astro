---
import PageLayout from "@/layouts/PageLayout.astro";
import YouTubeEmbed from "@/components/YouTubeEmbed.astro";
import { siteData } from "@/data/site";

const { videos, social, video } = siteData;
const [featured, ...others] = videos;
---

<PageLayout
	title="Pinoy Techie Videos"
	description="Watch Pinoy Techie tutorials on MariBank and everyday money apps in the Philippines. Short, practical walkthroughs from our YouTube channel."
	lead="Short, practical walkthroughs on MariBank and everyday money apps."
	path="/videos/"
	prose={false}>
	{
		featured && (
			<section aria-labelledby="featured-title">
				<h2 id="featured-title" class="text-2xl font-bold tracking-tight text-navy-900">Featured video</h2>
				<div class="mt-6 grid gap-8 lg:grid-cols-12 lg:items-start">
					<div class="lg:col-span-8">
						<YouTubeEmbed id={featured.id} si={featured.id === video.id ? video.si : undefined} title={featured.title} />
					</div>
					<div class="lg:col-span-4">
						<h3 class="text-xl font-semibold text-navy-900">{featured.title}</h3>
						<p class="mt-2 text-slate-600">{featured.description}</p>
						{social.youtube && (
							<a
								href={social.youtube}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-5 inline-flex rounded-md bg-navy-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-navy-700">
								Subscribe on YouTube
							</a>
						)}
					</div>
				</div>
			</section>
		)
	}

	{
		others.length > 0 && (
			<section class="mt-14" aria-labelledby="more-videos-title">
				<h2 id="more-videos-title" class="text-2xl font-bold tracking-tight text-navy-900">More videos</h2>
				<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{others.map((v) => (
						<article class="group relative overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
							<img
								src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
								alt=""
								width="480"
								height="360"
								loading="lazy"
								class="aspect-video w-full object-cover"
							/>
							<div class="p-5">
								<h3 class="font-semibold text-navy-900">
									<a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0">
										{v.title}
									</a>
								</h3>
								<p class="mt-1 text-sm text-slate-600">{v.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>
		)
	}

	<section class="mt-14 rounded-xl border border-slate-200 bg-white p-6 md:p-8">
		<h2 class="text-xl font-semibold text-navy-900">Prefer to read?</h2>
		<p class="mt-2 max-w-2xl text-slate-600">
			Every video topic has a written guide with the details, tables and up-to-date numbers.
		</p>
		<a href="/blog/" class="mt-4 inline-flex font-semibold text-brand-600 hover:text-brand-700">Browse the guides →</a>
	</section>
</PageLayout>
