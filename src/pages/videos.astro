---
import PageLayout from "@/layouts/PageLayout.astro";
import YouTubeEmbed from "@/components/YouTubeEmbed.astro";
import { siteData } from "@/data/site";
import { featuredVideos, otherVideos, videoCategories } from "@/data/videos";

const { social } = siteData;
const perPage = siteData.paging.videosPerPage;
const [mainFeatured, ...moreFeatured] = featuredVideos;
const showFilters = videoCategories.length > 1;
const thumb = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const watch = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---

<PageLayout
	title="Pinoy Techie Videos"
	description="Watch Pinoy Techie videos: Philippine facts and stories, plus our earlier how-tos on MariBank, Piso WiFi, gadgets and everyday tech."
	lead="Philippine facts and stories from the Pinoy Techie YouTube channel, plus our earlier tech how-tos."
	path="/videos/"
	prose={false}>
	{
		mainFeatured && (
			<section aria-labelledby="featured-title">
				<div class="flex items-center gap-3">
					<h2 id="featured-title" class="text-3xl font-bold tracking-tight text-ink">Featured</h2>
					<span class="nb-tag nb-tag-red">Pinned</span>
				</div>
				<div class="mt-6 grid gap-8 lg:grid-cols-12 lg:items-start">
					<div class="lg:col-span-8">
						<YouTubeEmbed id={mainFeatured.id} si={mainFeatured.si} title={mainFeatured.title} />
					</div>
					<div class="lg:col-span-4">
						{mainFeatured.category && (
							<span class="nb-tag">{mainFeatured.category}</span>
						)}
						<h3 class="mt-3 text-xl font-bold leading-snug tracking-tight text-ink sm:text-2xl">{mainFeatured.title}</h3>
						{mainFeatured.description && <p class="mt-3 font-medium text-body">{mainFeatured.description}</p>}
						<div class="mt-5 flex flex-wrap gap-3">
							{social.youtube && (
								<a
									href={social.youtube}
									target="_blank"
									rel="noopener noreferrer"
									class="nb-btn nb-btn-dark">
									Subscribe on YouTube
								</a>
							)}
							<a
								href={watch(mainFeatured.id)}
								target="_blank"
								rel="noopener noreferrer"
								class="nb-btn nb-btn-white">
								Watch on YouTube
							</a>
						</div>
					</div>
				</div>
			</section>
		)
	}

	{
		moreFeatured.length > 0 && (
			<div class="mt-10 grid gap-8 lg:grid-cols-2">
				{moreFeatured.map((v) => (
					<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
						<YouTubeEmbed id={v.id} si={v.si} title={v.title} />
						<div>
							{v.category && <span class="nb-tag">{v.category}</span>}
							<h3 class="mt-2 font-bold leading-snug text-ink">{v.title}</h3>
							{v.description && <p class="mt-1 text-sm text-body">{v.description}</p>}
						</div>
					</div>
				))}
			</div>
		)
	}

	{
		otherVideos.length > 0 && (
			<section class={mainFeatured ? "mt-16" : ""} aria-labelledby="all-videos-title">
				<div class="flex flex-wrap items-end justify-between gap-4">
					<h2 id="all-videos-title" class="text-3xl font-bold tracking-tight text-ink">
						{mainFeatured ? "More videos" : "All videos"}
					</h2>
					{showFilters && (
						<div class="flex flex-wrap gap-2" role="group" aria-label="Filter videos by topic" data-video-filters>
							<button type="button" data-filter="all" aria-pressed="true" class="nb-chip">All</button>
							{videoCategories.map((c) => (
								<button type="button" data-filter={c} aria-pressed="false" class="nb-chip">{c}</button>
							))}
						</div>
					)}
				</div>
				<div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-video-grid data-per-page={perPage}>
					{otherVideos.map((v, i) => (
						<article
							data-category={v.category ?? ""}
							hidden={i >= perPage}
							class="group nb-card nb-card-lift relative overflow-hidden hover:bg-sun-soft">
							<img src={thumb(v.id)} alt="" width="480" height="360" loading="lazy" class="aspect-video w-full border-b-[3px] border-ink object-cover" />
							<div class="p-5">
								{v.category && <span class="nb-tag">{v.category}</span>}
								<h3 class="mt-2 font-bold leading-snug text-ink">
									<a href={watch(v.id)} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0">
										{v.title}
									</a>
								</h3>
								{v.description && <p class="mt-1 text-sm text-body">{v.description}</p>}
							</div>
						</article>
					))}
				</div>
				<div data-video-pager></div>
				<noscript><style>article[data-category][hidden]{display:block!important}</style></noscript>
			</section>
		)
	}

	<section class="nb-card mt-16 bg-sun p-6 md:p-8">
		<h2 class="text-2xl font-bold tracking-tight text-ink">Prefer to read?</h2>
		<p class="mt-2 max-w-2xl font-medium text-ink/90">
			Our MariBank and money-app videos have written guides with the details, tables and up-to-date numbers.
		</p>
		<a href="/blog/" class="nb-btn nb-btn-dark mt-5">Browse the guides →</a>
	</section>
</PageLayout>
<script>
	import { pageWindow } from "@/lib/pagination";

	// Topic filter + pagination for the video grid. All videos stay in the HTML (so search
	// engines and no-JS visitors see them); this only shows one page at a time.
	const grid = document.querySelector<HTMLElement>("[data-video-grid]");
	const pager = document.querySelector<HTMLElement>("[data-video-pager]");
	if (grid && pager) {
		const perPage = Number(grid.dataset.perPage) || 12;
		const cards = [...grid.querySelectorAll<HTMLElement>("article[data-category]")];
		const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-video-filters] [data-filter]")];
		const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

		const params = new URLSearchParams(location.search);
		let filter = params.get("topic") ?? "all";
		if (!chips.some((c) => c.dataset.filter === filter)) filter = "all";
		let page = Math.max(1, parseInt(params.get("page") ?? "1", 10) || 1);

		function render(scrollToGrid: boolean) {
			const matches = cards.filter((c) => filter === "all" || c.dataset.category === filter);
			const totalPages = Math.max(1, Math.ceil(matches.length / perPage));
			page = Math.min(page, totalPages);
			const start = (page - 1) * perPage;
			const visible = new Set(matches.slice(start, start + perPage));
			cards.forEach((c) => (c.hidden = !visible.has(c)));
			chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.filter === filter)));

			const q = new URLSearchParams();
			if (filter !== "all") q.set("topic", filter);
			if (page > 1) q.set("page", String(page));
			history.replaceState(null, "", location.pathname + (q.size ? `?${q}` : ""));

			if (totalPages <= 1) {
				pager.innerHTML = "";
			} else {
				const btn = (label: string, target: number, opts: { current?: boolean; disabled?: boolean; aria?: string } = {}) =>
					`<li><button type="button" class="nb-page" data-page="${target}"${opts.current ? ' aria-current="page"' : ""}${
						opts.disabled ? " disabled" : ""
					} aria-label="${opts.aria ?? `Page ${target}`}">${label}</button></li>`;
				const items = pageWindow(page, totalPages)
					.map((n) => (n === "…" ? '<li><span class="nb-page-gap" aria-hidden="true">…</span></li>' : btn(String(n), n, { current: n === page })))
					.join("");
				pager.innerHTML =
					`<nav aria-label="Pagination" class="mt-14 flex flex-col items-center gap-4"><ul class="flex flex-wrap items-center justify-center gap-2.5">` +
					btn("← <span class='ml-1 hidden sm:inline'>Prev</span>", page - 1, { disabled: page === 1, aria: "Previous page" }) +
					items +
					btn("<span class='mr-1 hidden sm:inline'>Next</span> →", page + 1, { disabled: page === totalPages, aria: "Next page" }) +
					`</ul><p class="font-mono text-xs font-bold uppercase tracking-wide text-muted">Showing ${start + 1}–${start + visible.size} of ${matches.length} videos</p></nav>`;
			}

			if (scrollToGrid) {
				document.getElementById("all-videos-title")?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
			}
		}

		pager.addEventListener("click", (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-page]");
			if (!b || b.disabled) return;
			page = Number(b.dataset.page);
			render(true);
		});
		document.querySelector("[data-video-filters]")?.addEventListener("click", (e) => {
			const chip = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
			if (!chip) return;
			filter = chip.dataset.filter ?? "all";
			page = 1;
			render(false);
		});

		render(false);
	}
</script>
