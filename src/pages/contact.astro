---
import PageLayout from "@/layouts/PageLayout.astro";
import { siteData } from "@/data/site";

const { social, name } = siteData;
---

<PageLayout
	title="Contact Pinoy Techie"
	description="How to reach Pinoy Techie for corrections, feedback, or collaboration, and what we cannot help with, such as account or MariBank support."
	lead="Corrections, feedback and collaboration requests are welcome."
	path="/contact/"
	type="ContactPage"
	prose={false}>
	<div class="grid gap-8 md:grid-cols-12">
		<div class="space-y-6 md:col-span-7">
			<div class="rounded-xl border border-line glass p-6 shadow-sm">
				<h2 class="text-xl font-semibold text-ink">Get in touch</h2>
				<ul class="mt-4 space-y-4 text-body">
					{
						social.email && (
							<li>
								<p class="text-sm font-medium text-muted">Email</p>
								<a class="font-semibold text-accent hover:underline" href={`mailto:${social.email}`}>{social.email}</a>
							</li>
						)
					}
					{
						social.youtube && (
							<li>
								<p class="text-sm font-medium text-muted">YouTube</p>
								<a class="font-semibold text-accent hover:underline" href={social.youtube} target="_blank" rel="noopener noreferrer">
									{social.youtube.replace("https://www.", "")}
								</a>
								<p class="mt-1 text-sm text-muted">Leave a comment or message us there.</p>
							</li>
						)
					}
					{!social.email && !social.youtube && <li>Contact details are coming soon.</li>}
				</ul>
			</div>

			<div class="rounded-xl border border-line glass p-6 shadow-sm">
				<h2 class="text-xl font-semibold text-ink">Good reasons to write</h2>
				<ul class="mt-3 list-disc space-y-2 pl-5 text-body">
					<li>You spotted an error or an out-of-date number in a guide.</li>
					<li>You want a topic covered.</li>
					<li>Business or collaboration inquiries.</li>
				</ul>
			</div>
		</div>

		<aside class="md:col-span-5">
			<div class="glass-dark rounded-xl p-6 text-white">
				<h2 class="text-lg font-semibold">What we can't help with</h2>
				<p class="mt-3 text-sm leading-relaxed text-slate-300">
					{name} is not MariBank. We cannot see or change your account, reverse transactions, or give financial advice. For account
					problems, use the in-app help of your bank or e-wallet, and never share your OTP, PIN or password with anyone.
				</p>
			</div>
		</aside>
	</div>
</PageLayout>
