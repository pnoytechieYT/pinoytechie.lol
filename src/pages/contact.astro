---
import PageLayout from "@/layouts/PageLayout.astro";
import { siteData } from "@/data/site";

const { social, name } = siteData;
---

<PageLayout
	title="Contact Pinoy Techie"
	description="How to reach Pinoy Techie for corrections, feedback, or collaboration, and what we cannot help with, such as account or MariBank support."
	lead="Corrections, feedback and collaboration requests are welcome."
	path="/contact/"
	type="ContactPage"
	prose={false}>
	<div class="grid gap-8 md:grid-cols-12">
		<div class="space-y-6 md:col-span-7">
			<div class="nb-card p-6">
				<h2 class="text-2xl font-bold tracking-tight text-ink">Get in touch</h2>
				<ul class="mt-5 space-y-5 text-body">
					{
						social.email && (
							<li>
								<p class="nb-eyebrow text-muted">Email</p>
								<a class="text-lg font-bold text-flame-dark underline decoration-2 underline-offset-4 hover:bg-sun hover:text-ink" href={`mailto:${social.email}`}>{social.email}</a>
							</li>
						)
					}
					{
						social.youtube && (
							<li>
								<p class="nb-eyebrow text-muted">YouTube</p>
								<a class="text-lg font-bold text-flame-dark underline decoration-2 underline-offset-4 hover:bg-sun hover:text-ink" href={social.youtube} target="_blank" rel="noopener noreferrer">
									{social.youtube.replace("https://www.", "")}
								</a>
								<p class="mt-1 text-sm font-medium text-muted">Leave a comment or message us there.</p>
							</li>
						)
					}
					{!social.email && !social.youtube && <li>Contact details are coming soon.</li>}
				</ul>
			</div>

			<div class="nb-card bg-sun-soft p-6">
				<h2 class="text-2xl font-bold tracking-tight text-ink">Good reasons to write</h2>
				<ul class="mt-4 list-disc space-y-2 pl-5 font-medium text-body marker:font-bold marker:text-flame-dark">
					<li>You spotted an error or an out-of-date number in a guide.</li>
					<li>You want a topic covered.</li>
				</ul>
			</div>
		</div>

		<aside class="md:col-span-5">
			<div class="nb-card bg-amber md:-rotate-1 p-6">
				<span class="nb-tag nb-tag-dark">Heads up</span>
				<h2 class="mt-3 text-xl font-bold tracking-tight text-ink">What we can't help with</h2>
				<p class="mt-3 font-medium leading-relaxed text-ink">
					{name} is not MariBank. We cannot see or change your account, reverse transactions, or give financial advice. For account
					problems, use the in-app help of your bank or e-wallet, and never share your OTP, PIN or password with anyone.
				</p>
			</div>
		</aside>
	</div>
</PageLayout>
