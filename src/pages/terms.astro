---
import PageLayout from "@/layouts/PageLayout.astro";
import { siteData } from "@/data/site";
import { formatDate } from "@/lib/posts";

const { name, legalUpdated } = siteData;
const updated = formatDate(new Date(`${legalUpdated}T00:00:00${siteData.timezoneOffset}`));
---

<PageLayout
	title="Terms of Use"
	description="The terms for using pinoytechie.lol: information only, not financial advice, no affiliation with MariBank, third-party links, and limits of liability."
	lead={`Last updated ${updated}`}
	path="/terms/"
	dateModified={`${legalUpdated}T00:00:00${siteData.timezoneOffset}`}>
	<p>By using pinoytechie.lol you agree to these terms. If you do not agree, please do not use the site.</p>

	<h2>Information only, not advice</h2>
	<p>
		Everything on {name} is general information. It is not financial, legal, tax or investment advice, and it does not consider your
		personal situation. Decide for yourself, and talk to a qualified professional where needed.
	</p>

	<h2>No affiliation</h2>
	<p>
		{name} is independent. We are not affiliated with, endorsed by or sponsored by MariBank Philippines, Sea Group, GCash or any other
		company we mention. Product names and logos belong to their owners.
	</p>

	<h2>Accuracy and changes</h2>
	<p>
		We try to keep guides accurate and show when each was published or updated. Interest rates, fees, limits and promo terms are set
		by the providers and change often. Always confirm current terms in the official app or with the provider before you act.
	</p>

	<h2>Referral codes and rewards</h2>
	<p>
		We share a referral code and may earn a reward when you sign up with it. Whether you qualify for any reward is decided by the
		provider under its own terms. We do not promise or guarantee any reward. See the <a href="/disclosure/">referral disclosure</a>.
	</p>

	<h2>Third-party links</h2>
	<p>
		The site links to websites and apps we do not control. We are not responsible for their content, security or practices.
	</p>

	<h2>Intellectual property</h2>
	<p>
		The articles, design and logo of {name} are protected by copyright. You may quote short excerpts with a link back to the source. Do
		not republish whole articles without permission.
	</p>

	<h2>Disclaimer of warranties and limitation of liability</h2>
	<p>
		The site is provided "as is" and "as available" without warranties of any kind. To the fullest extent permitted by Philippine law,
		{name} is not liable for losses arising from your use of, or reliance on, the site or any linked service.
	</p>

	<h2>Governing law</h2>
	<p>These terms are governed by the laws of the Republic of the Philippines.</p>

	<h2>Changes to these terms</h2>
	<p>We may update these terms and will change the date above when we do. Continued use means you accept the updated terms.</p>

	<h2>Contact</h2>
	<p>Questions about these terms: use the <a href="/contact/">contact page</a>.</p>
</PageLayout>
